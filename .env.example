# Copy this file to .env and fill in all values before starting the stack.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin user created on first start. Change the password to something strong.
ADMIN_EMAIL=admin@gourmant.test
ADMIN_PASSWORD=change-me-now-please-99

# Set to true when running behind the Cloudflare Tunnel (HTTPS).
# Keep false for local HTTP dev (http://localhost:8000).
SESSION_COOKIE_SECURE=false
